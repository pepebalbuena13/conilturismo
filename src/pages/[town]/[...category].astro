---
import TownView from "../../views/TownView.astro";
import { CATEGORIES, BEACH_CATEGORY } from "../../data/categories";
import { TOWNS } from "../../lib/business";

export function getStaticPaths() {
  return TOWNS.flatMap((town) => [
    { params: { town: town.slug, category: undefined }, props: { townSlug: town.slug, categoryId: undefined } },
    ...CATEGORIES.map((cat) => ({
      params: { town: town.slug, category: cat.slug.es },
      props: { townSlug: town.slug, categoryId: cat.id },
    })),
    {
      params: { town: town.slug, category: BEACH_CATEGORY.slug.es },
      props: { townSlug: town.slug, categoryId: BEACH_CATEGORY.id },
    },
  ]);
}

const { townSlug, categoryId } = Astro.props as { townSlug: string; categoryId?: string };
---

<TownView locale="es" townSlug={townSlug} categoryId={categoryId} />
