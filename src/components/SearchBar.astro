---
import type { Locale } from "../data/categories";
import { CATEGORIES } from "../data/categories";
import { TOWNS } from "../lib/business";
import { t } from "../lib/i18n";
import { searchPath } from "../lib/paths";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = "" } = Astro.props;
---

<form
  method="get"
  action={searchPath(locale)}
  class={`flex w-full flex-col gap-2 rounded-2xl bg-arena-soft/95 p-2 shadow-lift sm:flex-row sm:items-center ${className}`}
  role="search"
>
  <label for="hero-search" class="sr-only">{t(locale, "home.searchLabel")}</label>
  <div class="flex flex-1 items-center gap-2 rounded-xl px-3 py-2.5">
    <Icon name="search" class="h-5 w-5 shrink-0 text-atlantico/60" />
    <input
      id="hero-search"
      type="text"
      name="q"
      placeholder={t(locale, "home.searchPlaceholder")}
      class="w-full bg-transparent text-base text-tinta placeholder:text-tinta/40 focus:outline-none"
      autocomplete="off"
    />
  </div>

  <div class="grid grid-cols-2 gap-2 sm:contents">
    <div class="relative">
      <label for="hero-town" class="sr-only">{t(locale, "search.townLabel")}</label>
      <select
        id="hero-town"
        name="town"
        class="tap-target w-full appearance-none rounded-xl border border-tinta/10 bg-white px-3 py-2.5 pr-8 text-sm text-tinta focus:border-atlantico focus:outline-none sm:w-40"
      >
        <option value="">{t(locale, "search.allTowns")}</option>
        {TOWNS.map((town) => <option value={town.slug}>{town.name.split(" / ")[0]}</option>)}
      </select>
      <Icon name="chevron-right" class="pointer-events-none absolute right-2.5 top-1/2 h-4 w-4 -translate-y-1/2 rotate-90 text-tinta/40" />
    </div>

    <div class="relative">
      <label for="hero-category" class="sr-only">{t(locale, "search.categoryLabel")}</label>
      <select
        id="hero-category"
        name="cat"
        class="tap-target w-full appearance-none rounded-xl border border-tinta/10 bg-white px-3 py-2.5 pr-8 text-sm text-tinta focus:border-atlantico focus:outline-none sm:w-44"
      >
        <option value="">{t(locale, "search.allCategories")}</option>
        {CATEGORIES.map((cat) => <option value={cat.id}>{cat.label[locale]}</option>)}
      </select>
      <Icon name="chevron-right" class="pointer-events-none absolute right-2.5 top-1/2 h-4 w-4 -translate-y-1/2 rotate-90 text-tinta/40" />
    </div>
  </div>

  <button
    type="submit"
    class="tap-target flex items-center justify-center gap-2 rounded-xl bg-terracota px-6 py-3 text-sm font-semibold text-arena-soft transition-colors hover:bg-terracota-light"
  >
    {t(locale, "home.searchCta")}
  </button>
</form>
