---
// Loads a real photo from /public/images/<relPath>.{jpg,jpeg,png,webp} when
// it exists on disk; otherwise renders the generated PlaceholderImage scene.
// This keeps content and design decoupled: dropping a real photo file in
// the right folder is all that's needed to replace a placeholder.
import fs from "node:fs";
import path from "node:path";
import PlaceholderImage from "./PlaceholderImage.astro";

interface Props {
  relPath: string;
  seed: string;
  label?: string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  showInitials?: boolean;
  objectPosition?: string;
}

const {
  relPath,
  seed,
  label,
  alt,
  class: className = "",
  loading = "lazy",
  showInitials = true,
  objectPosition,
} = Astro.props;

const EXTENSIONS = ["jpg", "jpeg", "png", "webp"];
let foundUrl: string | null = null;
for (const ext of EXTENSIONS) {
  const diskPath = path.join(process.cwd(), "public", "images", `${relPath}.${ext}`);
  if (fs.existsSync(diskPath)) {
    foundUrl = `/images/${relPath}.${ext}`;
    break;
  }
}
---

{foundUrl ? (
  <img
    src={foundUrl}
    alt={alt}
    loading={loading}
    class={className}
    decoding="async"
    style={objectPosition ? `object-position: ${objectPosition}` : undefined}
  />
) : (
  <PlaceholderImage seed={seed} label={label} alt={alt} class={className} showInitials={showInitials} />
)}
