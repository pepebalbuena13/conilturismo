---
import type { Locale } from "../data/categories";
import type { Town } from "../lib/business";
import { t } from "../lib/i18n";
import { townPath } from "../lib/paths";
import SmartImage from "./SmartImage.astro";
import Icon from "./Icon.astro";

interface Props {
  town: Town;
  locale: Locale;
}

const { town, locale } = Astro.props;
const hasNameCard = Boolean(town.nameCardPhoto);
const photoIndex = town.nameCardPhoto ?? 1;
const relPath = `${town.slug}/hero/${photoIndex}`;
const photoAlt = town.gallery[photoIndex - 1]?.[locale] ?? town.name;
---

<a
  href={townPath(locale, town.slug)}
  class="group relative flex aspect-[3/4] w-full flex-col justify-end overflow-hidden rounded-3xl shadow-card transition-transform duration-500 hover:-translate-y-1"
>
  <div class="absolute inset-0 transition-transform duration-700 ease-out group-hover:scale-105">
    {hasNameCard ? (
      <>
        <SmartImage
          relPath={relPath}
          seed={town.gallerySeed}
          alt=""
          class="h-full w-full scale-125 object-cover brightness-75 blur-2xl"
          showInitials={false}
          loading="eager"
        />
        <SmartImage
          relPath={relPath}
          seed={town.gallerySeed}
          label={town.name}
          alt={photoAlt}
          class="absolute inset-0 h-full w-full object-contain"
          showInitials={false}
          loading="eager"
        />
      </>
    ) : (
      <SmartImage
        relPath={relPath}
        seed={town.gallerySeed}
        label={town.name}
        alt={photoAlt}
        class="h-full w-full object-cover"
        showInitials={false}
      />
    )}
  </div>
  <div class={`absolute inset-0 bg-gradient-to-t ${hasNameCard ? "from-tinta/55 via-transparent to-transparent" : "from-tinta/85 via-tinta/20 to-transparent"}`}></div>
  <div class="relative p-5 sm:p-6">
    {!hasNameCard && (
      <>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-dorado-soft">{town.tagline[locale]}</p>
        <h3 class="mt-1 font-display text-2xl font-semibold text-arena-soft text-balance">{town.name.split(" / ")[0]}</h3>
      </>
    )}
    <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-arena-soft/90">
      {t(locale, "home.exploreTown")}
      <Icon name="chevron-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</a>
