---
import type { Locale } from "../data/categories";
import type { Town } from "../lib/business";
import { t } from "../lib/i18n";
import { townPath } from "../lib/paths";
import SmartImage from "./SmartImage.astro";
import Icon from "./Icon.astro";

interface Props {
  town: Town;
  locale: Locale;
}

const { town, locale } = Astro.props;
const photos = town.gallery.map((caption, i) => ({
  relPath: `${town.slug}/hero/${i + 1}`,
  alt: caption[locale] ?? town.name,
}));
---

<a
  href={townPath(locale, town.slug)}
  data-fade-carousel
  class="group relative flex aspect-[3/4] w-full flex-col justify-end overflow-hidden rounded-3xl shadow-card transition-transform duration-500 hover:-translate-y-1"
>
  <div class="absolute inset-0 transition-transform duration-700 ease-out group-hover:scale-105">
    {photos.map((photo, i) => (
      <div
        data-fade-slide
        class={`absolute inset-0 transition-opacity duration-[1500ms] ease-in-out ${i === 0 ? "opacity-100" : "opacity-0"}`}
      >
        <SmartImage
          relPath={photo.relPath}
          seed={`${town.gallerySeed}-${i}`}
          label={town.name}
          alt={photo.alt}
          class="h-full w-full object-cover"
          showInitials={false}
          loading={i === 0 ? "eager" : "lazy"}
        />
      </div>
    ))}
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-tinta/85 via-tinta/20 to-transparent"></div>
  <div class="relative p-5 sm:p-6">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-dorado-soft">{town.tagline[locale]}</p>
    <h3 class="mt-1 font-display text-2xl font-semibold text-arena-soft text-balance">{town.name.split(" / ")[0]}</h3>
    <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-arena-soft/90">
      {t(locale, "home.exploreTown")}
      <Icon name="chevron-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</a>

<script>
  const INTERVAL_MS = 4000;

  document.addEventListener("astro:page-load", () => {
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll("[data-fade-carousel]").forEach((card) => {
    const slides = Array.from(card.querySelectorAll("[data-fade-slide]"));
    if (slides.length < 2 || reduceMotion) return;

    let current = 0;
    let timer: number | null = null;

    function next() {
      const nextIndex = (current + 1) % slides.length;
      slides[current].classList.replace("opacity-100", "opacity-0");
      slides[nextIndex].classList.replace("opacity-0", "opacity-100");
      current = nextIndex;
    }

    function start() {
      stop();
      timer = window.setInterval(next, INTERVAL_MS);
    }
    function stop() {
      if (timer) window.clearInterval(timer);
      timer = null;
    }

    start();
    card.addEventListener("mouseenter", stop);
    card.addEventListener("mouseleave", start);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else start();
    });
  });
  });
</script>
