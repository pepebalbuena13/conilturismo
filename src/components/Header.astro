---
import { CATEGORIES, BEACH_CATEGORY, type Locale } from "../data/categories";
import { TOWNS } from "../lib/business";
import { t } from "../lib/i18n";
import { homePath, townPath, searchPath, promotePath, beachesPath } from "../lib/paths";
import Icon from "./Icon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  locale: Locale;
  hrefs: Record<Locale, string>;
  currentTownSlug?: string;
}

const { locale, hrefs, currentTownSlug } = Astro.props;

const sectionLinks = [
  { href: beachesPath(locale), icon: BEACH_CATEGORY.icon, label: BEACH_CATEGORY.label[locale] },
  ...CATEGORIES.map((cat) => ({
    href: townPath(locale, TOWNS[0].slug, cat.slug[locale]),
    icon: cat.icon,
    label: cat.label[locale],
  })),
];
---

<header class="sticky top-0 z-50 border-b border-tinta/10 bg-arena/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-1 shrink-0">
      <div class="relative hidden lg:block" data-sections-dropdown>
        <button
          type="button"
          id="sections-toggle"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="sections-menu"
          aria-label={t(locale, "nav.sections")}
          class="tap-target flex h-9 w-9 items-center justify-center rounded-full text-atlantico transition-colors hover:bg-atlantico/10"
        >
          <Icon name="menu" class="h-5 w-5" />
        </button>
        <div
          id="sections-menu"
          role="menu"
          class="absolute left-0 top-full mt-2 hidden w-60 rounded-2xl bg-white p-2 shadow-lift ring-1 ring-tinta/10"
        >
          {sectionLinks.map((section) => (
            <a
              href={section.href}
              role="menuitem"
              class="flex items-center gap-2.5 rounded-xl px-3 py-2.5 text-sm font-medium text-tinta/80 transition-colors hover:bg-atlantico/10 hover:text-atlantico"
            >
              <Icon name={section.icon} class="h-4 w-4" />
              {section.label}
            </a>
          ))}
        </div>
      </div>

      <a href={homePath(locale)} class="flex items-center gap-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-atlantico text-arena-soft">
          <Icon name="brand" class="h-5 w-5" />
        </span>
        <span class="font-display leading-none">
          <span class="block text-base font-semibold text-atlantico">Costa de la Luz</span>
          <span class="block text-[11px] uppercase tracking-[0.2em] text-terracota">Turismo</span>
        </span>
      </a>
    </div>

    <nav class="hidden items-center gap-2 lg:flex" aria-label={t(locale, "nav.towns")}>
      {TOWNS.map((town) => (
        <a
          href={townPath(locale, town.slug)}
          class={`flex h-12 w-28 flex-none items-center justify-center rounded-2xl px-1.5 text-center text-xs font-medium leading-tight transition-colors ${
            currentTownSlug === town.slug
              ? "bg-atlantico text-arena-soft"
              : "bg-white/70 text-tinta/80 ring-1 ring-tinta/10 hover:bg-atlantico/10 hover:text-atlantico hover:ring-atlantico/30"
          }`}
        >{town.name.split(" / ")[0]}</a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a
        href={searchPath(locale)}
        class="tap-target flex items-center gap-2 rounded-full border border-tinta/15 px-3 py-2 text-sm font-medium text-tinta/80 transition-colors hover:border-atlantico hover:text-atlantico"
      >
        <Icon name="search" class="h-4 w-4" />
        {t(locale, "nav.search")}
      </a>
      <LanguageSwitcher locale={locale} hrefs={hrefs} />
      <a
        href={promotePath(locale)}
        class="tap-target flex w-20 flex-col items-center justify-center rounded-full bg-terracota px-2 py-1.5 text-center text-[11px] font-semibold leading-tight text-arena-soft transition-colors hover:bg-terracota-light"
      >
        {t(locale, "promote.metaTitle")}
      </a>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <a href={searchPath(locale)} class="tap-target flex items-center justify-center rounded-full text-atlantico" aria-label={t(locale, "nav.search")}>
        <Icon name="search" class="h-5 w-5" />
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="tap-target flex items-center justify-center rounded-full text-atlantico"
        aria-label={t(locale, "nav.openMenu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] hidden flex-col bg-atlantico px-6 py-6 text-arena-soft"
  role="dialog"
  aria-modal="true"
  aria-label={t(locale, "nav.menu")}
>
  <div class="flex items-center justify-between">
    <span class="font-display text-lg font-semibold">Costa de la Luz Turismo</span>
    <button
      id="menu-close"
      type="button"
      class="tap-target flex items-center justify-center rounded-full text-arena-soft"
      aria-label={t(locale, "nav.closeMenu")}
    >
      <Icon name="close" class="h-6 w-6" />
    </button>
  </div>

  <nav class="mt-10 flex flex-col gap-1" aria-label={t(locale, "nav.towns")}>
    {TOWNS.map((town) => (
      <a
        href={townPath(locale, town.slug)}
        class="border-b border-arena-soft/10 py-4 font-display text-2xl transition-colors hover:text-dorado"
      >{town.name}</a>
    ))}
    <a href={searchPath(locale)} class="mt-4 flex items-center gap-2 py-2 text-base font-medium text-dorado-soft">
      <Icon name="search" class="h-5 w-5" />
      {t(locale, "nav.search")}
    </a>
  </nav>

  <nav class="mt-6 flex flex-col gap-1 border-t border-arena-soft/10 pt-6" aria-label={t(locale, "nav.sections")}>
    {sectionLinks.map((section) => (
      <a href={section.href} class="flex items-center gap-2 py-2 text-sm font-medium text-arena-soft/80 transition-colors hover:text-dorado-soft">
        <Icon name={section.icon} class="h-4 w-4" />
        {section.label}
      </a>
    ))}
  </nav>

  <div class="mt-6">
    <a
      href={promotePath(locale)}
      class="tap-target flex items-center justify-center rounded-full bg-terracota px-5 py-3 text-sm font-semibold text-arena-soft transition-colors hover:bg-terracota-light"
    >
      {t(locale, "promote.metaTitle")}
    </a>
  </div>

  <div class="mt-auto pt-8">
    <LanguageSwitcher locale={locale} hrefs={hrefs} variant="dark" />
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
  const toggle = document.getElementById("menu-toggle");
  const close = document.getElementById("menu-close");
  const menu = document.getElementById("mobile-menu");

  function openMenu() {
    menu?.classList.remove("hidden");
    menu?.classList.add("flex");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    menu?.classList.add("hidden");
    menu?.classList.remove("flex");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", openMenu);
  close?.addEventListener("click", closeMenu);
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });

  const sectionsWrapper = document.querySelector("[data-sections-dropdown]");
  const sectionsToggle = document.getElementById("sections-toggle");
  const sectionsMenu = document.getElementById("sections-menu");

  function openSections() {
    sectionsMenu?.classList.remove("hidden");
    sectionsToggle?.setAttribute("aria-expanded", "true");
  }

  function closeSections() {
    sectionsMenu?.classList.add("hidden");
    sectionsToggle?.setAttribute("aria-expanded", "false");
  }

  sectionsToggle?.addEventListener("click", (e) => {
    e.stopPropagation();
    const isOpen = sectionsToggle.getAttribute("aria-expanded") === "true";
    if (isOpen) closeSections();
    else openSections();
  });
  document.addEventListener("click", (e) => {
    if (sectionsWrapper && !sectionsWrapper.contains(e.target as Node)) closeSections();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeSections();
  });
  });
</script>
