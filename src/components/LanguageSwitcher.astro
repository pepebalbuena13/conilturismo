---
import { LOCALES, type Locale } from "../data/categories";
import { t } from "../lib/i18n";

interface Props {
  locale: Locale;
  hrefs: Record<Locale, string>;
  class?: string;
  variant?: "light" | "dark";
}

const { locale, hrefs, class: className = "", variant = "light" } = Astro.props;

const containerClass =
  variant === "dark"
    ? "border-arena-soft/25 bg-transparent"
    : "border-tinta/15 bg-arena-soft";

const activeClass = variant === "dark" ? "bg-dorado text-tinta" : "bg-atlantico text-arena-soft";
const inactiveClass =
  variant === "dark" ? "text-arena-soft/70 hover:text-arena-soft" : "text-atlantico/70 hover:text-atlantico";
---

<div
  class={`inline-flex items-center gap-0.5 rounded-full border p-0.5 ${containerClass} ${className}`}
  role="group"
  aria-label={t(locale, "lang.selectLabel")}
>
  {LOCALES.map((code) => (
    <a
      href={hrefs[code]}
      aria-current={locale === code ? "page" : undefined}
      title={t(locale, `lang.${code}`)}
      class={`tap-target flex items-center justify-center rounded-full px-2.5 py-1.5 text-sm font-semibold uppercase transition-colors ${
        locale === code ? activeClass : inactiveClass
      }`}
    >{code}</a>
  ))}
</div>
