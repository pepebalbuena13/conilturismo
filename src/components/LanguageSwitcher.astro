---
import type { Locale } from "../data/categories";

interface Props {
  locale: Locale;
  altHref: string;
  class?: string;
  variant?: "light" | "dark";
}

const { locale, altHref, class: className = "", variant = "light" } = Astro.props;

const containerClass =
  variant === "dark"
    ? "border-arena-soft/25 bg-transparent"
    : "border-tinta/15 bg-arena-soft";

const activeClass = variant === "dark" ? "bg-dorado text-tinta" : "bg-atlantico text-arena-soft";
const inactiveClass =
  variant === "dark" ? "text-arena-soft/70 hover:text-arena-soft" : "text-atlantico/70 hover:text-atlantico";
---

<div class={`inline-flex items-center gap-0.5 rounded-full border p-0.5 ${containerClass} ${className}`} role="group" aria-label="Language / Idioma">
  <a
    href="/"
    data-locale="es"
    aria-current={locale === "es" ? "page" : undefined}
    class={`tap-target flex items-center justify-center rounded-full px-3 py-1.5 text-sm font-semibold transition-colors ${
      locale === "es" ? activeClass : inactiveClass
    }`}
  >ES</a>
  <a
    href="/en/"
    data-locale="en"
    aria-current={locale === "en" ? "page" : undefined}
    class={`tap-target flex items-center justify-center rounded-full px-3 py-1.5 text-sm font-semibold transition-colors ${
      locale === "en" ? activeClass : inactiveClass
    }`}
  >EN</a>
</div>

<script define:vars={{ altHref, locale }}>
  // Point both language links at the true equivalent of the current page
  // (same town / category / business, just in the other locale) instead
  // of always bouncing to each locale's homepage.
  const group = document.currentScript?.previousElementSibling;
  if (group) {
    const other = locale === "es" ? "en" : "es";
    const link = group.querySelector(`a[data-locale="${other}"]`);
    if (link) link.setAttribute("href", altHref);
  }
</script>
