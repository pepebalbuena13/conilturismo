---
import { LOCALES, type Locale } from "../data/categories";
import { t } from "../lib/i18n";
import FlagIcon from "./FlagIcon.astro";

interface Props {
  locale: Locale;
  hrefs: Record<Locale, string>;
  class?: string;
  variant?: "light" | "dark";
}

const { locale, hrefs, class: className = "", variant = "light" } = Astro.props;

const containerClass =
  variant === "dark"
    ? "border-arena-soft/25 bg-transparent"
    : "border-tinta/15 bg-arena-soft";

const ringClass = variant === "dark" ? "ring-dorado" : "ring-atlantico";
---

<div
  class={`inline-flex items-center gap-1 rounded-full border p-1 ${containerClass} ${className}`}
  role="group"
  aria-label={t(locale, "lang.selectLabel")}
>
  {LOCALES.map((code) => (
    <a
      href={hrefs[code]}
      aria-current={locale === code ? "page" : undefined}
      title={t(locale, `lang.${code}`)}
      class={`tap-target flex items-center justify-center rounded-full p-1 transition-all ${
        locale === code ? `ring-2 ${ringClass}` : "opacity-60 hover:opacity-100"
      }`}
    >
      <FlagIcon locale={code} class="h-4 w-6 rounded-[2px]" />
      <span class="sr-only">{t(locale, `lang.${code}`)}</span>
    </a>
  ))}
</div>
