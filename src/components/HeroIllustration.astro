---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 1600 900"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="hero-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#1B3A4B" />
      <stop offset="45%" stop-color="#B5542C" />
      <stop offset="70%" stop-color="#DDA24B" />
      <stop offset="100%" stop-color="#F2E8D8" />
    </linearGradient>
    <radialGradient id="hero-sun" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#F2E8D8" />
      <stop offset="60%" stop-color="#DDA24B" />
      <stop offset="100%" stop-color="#DDA24B" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="hero-wave-1" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#2C5268" />
      <stop offset="100%" stop-color="#1B3A4B" />
    </linearGradient>
  </defs>

  <rect width="1600" height="900" fill="url(#hero-sky)" />
  <circle cx="1180" cy="330" r="220" fill="url(#hero-sun)" opacity="0.9" />
  <circle cx="1180" cy="330" r="90" fill="#F8F2E6" opacity="0.95" />

  <!-- distant birds -->
  <path d="M180 180 q18 -18 36 0 q18 -18 36 0" stroke="#2A2420" stroke-width="4" fill="none" opacity="0.35" stroke-linecap="round" />
  <path d="M280 230 q14 -14 28 0 q14 -14 28 0" stroke="#2A2420" stroke-width="4" fill="none" opacity="0.3" stroke-linecap="round" />

  <!-- headland silhouette -->
  <path d="M0 520 C 150 460, 260 430, 380 470 C 460 500, 520 560, 600 540 L 600 620 L 0 620 Z" fill="#1B3A4B" opacity="0.55" />

  <!-- sea layers -->
  <path d="M0 560 Q 200 520 400 560 T 800 560 T 1200 560 T 1600 560 V900 H0 Z" fill="url(#hero-wave-1)" opacity="0.92" />
  <path d="M0 620 Q 220 580 440 620 T 880 620 T 1320 620 T 1600 615 V900 H0 Z" fill="#1B3A4B" opacity="0.85" />
  <path d="M0 700 Q 240 660 480 700 T 960 700 T 1600 695 V900 H0 Z" fill="#132C39" opacity="0.9" />

  <!-- foam / shoreline -->
  <path d="M0 760 Q 200 740 400 762 T 800 760 T 1200 762 T 1600 758 V900 H0 Z" fill="#F2E8D8" opacity="0.85" />

  <!-- sand texture -->
  <rect x="0" y="770" width="1600" height="130" fill="#F2E8D8" />
  <g fill="#DDA24B" opacity="0.35">
    <circle cx="120" cy="820" r="3" /><circle cx="260" cy="850" r="2.5" /><circle cx="410" cy="810" r="3" />
    <circle cx="560" cy="860" r="2" /><circle cx="710" cy="830" r="3" /><circle cx="860" cy="800" r="2.5" />
    <circle cx="1010" cy="850" r="3" /><circle cx="1160" cy="820" r="2" /><circle cx="1310" cy="860" r="3" />
    <circle cx="1460" cy="810" r="2.5" />
  </g>
</svg>
