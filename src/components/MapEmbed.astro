---
import type { Locale } from "../data/categories";
import { t } from "../lib/i18n";

interface Props {
  lat: number;
  lng: number;
  label: string;
  locale: Locale;
  class?: string;
}

const { lat, lng, label, locale, class: className = "" } = Astro.props;
const delta = 0.008;
const bbox = `${lng - delta},${lat - delta},${lng + delta},${lat + delta}`;
const embedSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lng}`;
const externalHref = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=16/${lat}/${lng}`;
---

<div class={`overflow-hidden rounded-3xl shadow-card ${className}`}>
  <iframe
    title={`${t(locale, "business.viewOnMap")} — ${label}`}
    src={embedSrc}
    class="h-72 w-full sm:h-80"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
  <div class="flex items-center justify-between bg-white/70 px-4 py-2.5 text-sm">
    <span class="text-tinta/70">{label}</span>
    <a href={externalHref} target="_blank" rel="noopener noreferrer" class="font-semibold text-atlantico hover:text-terracota">
      {t(locale, "business.openInMaps")}
    </a>
  </div>
</div>
