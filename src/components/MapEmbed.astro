---
import type { Locale } from "../data/categories";
import { t } from "../lib/i18n";

interface Props {
  lat: number;
  lng: number;
  label: string;
  locale: Locale;
  class?: string;
  mapsUrl?: string;
}

const { lat, lng, label, locale, class: className = "", mapsUrl } = Astro.props;
const embedSrc = `https://www.google.com/maps?q=${lat},${lng}&z=16&output=embed`;
const externalHref = mapsUrl ?? `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
---

<div class={`overflow-hidden rounded-3xl shadow-card ${className}`}>
  <iframe
    title={`${t(locale, "business.viewOnMap")} — ${label}`}
    src={embedSrc}
    class="h-72 w-full sm:h-80"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
  <div class="flex items-center justify-between bg-white/70 px-4 py-2.5 text-sm">
    <span class="text-tinta/70">{label}</span>
    <a href={externalHref} target="_blank" rel="noopener noreferrer" class="font-semibold text-atlantico hover:text-terracota">
      {t(locale, "business.openInMaps")}
    </a>
  </div>
</div>
