---
import type { Locale } from "../data/categories";
import { CATEGORIES } from "../data/categories";
import { TOWNS } from "../lib/business";
import { t } from "../lib/i18n";
import { townPath, homePath } from "../lib/paths";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-tinta/10 bg-atlantico text-arena-soft">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href={homePath(locale)} class="flex items-center gap-2">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-dorado text-atlantico">
            <Icon name="sun" class="h-5 w-5" />
          </span>
          <span class="font-display text-lg font-semibold">Costa de la Luz Guide</span>
        </a>
        <p class="mt-4 max-w-xs text-sm text-arena-soft/70">{t(locale, "footer.tagline")}</p>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-dorado-soft">{t(locale, "footer.towns")}</h3>
        <ul class="mt-4 space-y-2 text-sm text-arena-soft/80">
          {TOWNS.map((town) => (
            <li><a href={townPath(locale, town.slug)} class="hover:text-dorado-soft">{town.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-dorado-soft">{t(locale, "footer.categories")}</h3>
        <ul class="mt-4 space-y-2 text-sm text-arena-soft/80">
          {CATEGORIES.map((cat) => (
            <li><a href={townPath(locale, TOWNS[0].slug, cat.slug[locale])} class="hover:text-dorado-soft">{cat.label[locale]}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-dorado-soft">{t(locale, "footer.about")}</h3>
        <p class="mt-4 text-sm text-arena-soft/70">{t(locale, "footer.aboutText")}</p>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-2 border-t border-arena-soft/10 pt-6 text-xs text-arena-soft/60 sm:flex-row">
      <p>© {year} Costa de la Luz Guide. {t(locale, "footer.rights")}</p>
    </div>
  </div>
</footer>
