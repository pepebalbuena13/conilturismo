---
export type IconName = "bed" | "fork" | "glass" | "music" | "compass" | "chevron-left" | "chevron-right" | "star" | "star-half" | "star-empty" | "map-pin" | "phone" | "globe" | "instagram" | "menu" | "close" | "search" | "clock" | "sun" | "check" | "waves";

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = "", strokeWidth = 1.75 } = Astro.props;
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "bed" && (
    <>
      <path d="M3 18v-7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v7" />
      <path d="M3 18v2M21 18v2" />
      <path d="M3 13h18" />
      <path d="M7 13V9a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v4" />
    </>
  )}
  {name === "fork" && (
    <>
      <path d="M7 3v7a2 2 0 0 0 4 0V3" />
      <path d="M9 10v11" />
      <path d="M17 3c-1.5 1.5-1.5 6 0 8c0.6 0.6 1 1 1 2v8" />
    </>
  )}
  {name === "glass" && (
    <>
      <path d="M6 3h12l-1.2 10.5a4.8 4.8 0 0 1-9.6 0L6 3Z" />
      <path d="M12 15.5V21M8 21h8" />
    </>
  )}
  {name === "music" && (
    <>
      <path d="M9 18V5l11-2v13" />
      <circle cx="6" cy="18" r="3" />
      <circle cx="17" cy="16" r="3" />
    </>
  )}
  {name === "compass" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M15 9l-2 6-6 2 2-6 6-2Z" />
    </>
  )}
  {name === "chevron-left" && <path d="M15 18l-6-6 6-6" />}
  {name === "chevron-right" && <path d="M9 18l6-6-6-6" />}
  {name === "star" && (
    <path
      fill="currentColor"
      stroke="none"
      d="M12 2.5l2.9 6.2 6.6.7-4.9 4.6 1.3 6.6-5.9-3.4-5.9 3.4 1.3-6.6L2.5 9.4l6.6-.7L12 2.5Z"
    />
  )}
  {name === "star-half" && (
    <>
      <path
        fill="currentColor"
        stroke="none"
        d="M12 2.5v15.6l-5.9 3.4 1.3-6.6-4.9-4.6 6.6-.7L12 2.5Z"
      />
      <path d="M12 2.5l2.9 6.2 6.6.7-4.9 4.6 1.3 6.6-5.9-3.4-5.9 3.4 1.3-6.6L2.5 9.4l6.6-.7L12 2.5Z" />
    </>
  )}
  {name === "star-empty" && (
    <path d="M12 2.5l2.9 6.2 6.6.7-4.9 4.6 1.3 6.6-5.9-3.4-5.9 3.4 1.3-6.6L2.5 9.4l6.6-.7L12 2.5Z" />
  )}
  {name === "map-pin" && (
    <>
      <path d="M20 10.5c0 6-8 11.5-8 11.5S4 16.5 4 10.5a8 8 0 0 1 16 0Z" />
      <circle cx="12" cy="10.5" r="2.5" />
    </>
  )}
  {name === "phone" && (
    <path d="M4 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v4a2 2 0 0 1-2 2C9.6 21 3 14.4 3 6a2 2 0 0 1 1-2Z" />
  )}
  {name === "globe" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18Z" />
    </>
  )}
  {name === "instagram" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
    </>
  )}
  {name === "menu" && (
    <>
      <path d="M4 7h16M4 12h16M4 17h16" />
    </>
  )}
  {name === "close" && <path d="M6 6l12 12M18 6L6 18" />}
  {name === "search" && (
    <>
      <circle cx="11" cy="11" r="7" />
      <path d="M21 21l-4.3-4.3" />
    </>
  )}
  {name === "clock" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {name === "sun" && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
    </>
  )}
  {name === "check" && <path d="M5 12l5 5 9-10" />}
  {name === "waves" && (
    <>
      <path d="M2 8c2-2 4-2 6 0s4 2 6 0 4-2 6 0" />
      <path d="M2 14c2-2 4-2 6 0s4 2 6 0 4-2 6 0" />
      <path d="M2 20c2-2 4-2 6 0s4 2 6 0 4-2 6 0" />
    </>
  )}
</svg>
