---
import type { Locale } from "../data/categories";
import type { Review } from "../lib/business";
import { t } from "../lib/i18n";
import { getInitials } from "../lib/placeholder";
import RatingStars from "./RatingStars.astro";

interface Props {
  reviews: Review[];
  locale: Locale;
}

const { reviews, locale } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat(locale === "es" ? "es-ES" : "en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<section aria-labelledby="reviews-heading">
  <h2 id="reviews-heading" class="font-display text-2xl font-semibold text-atlantico">{t(locale, "business.reviewsTitle")}</h2>

  {reviews.length > 0 ? (
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {reviews.map((review) => (
        <li class="rounded-2xl bg-white/70 p-5 shadow-card ring-1 ring-tinta/5">
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-atlantico font-display text-sm font-semibold text-arena-soft">
                {getInitials(review.author)}
              </span>
              <div>
                <p class="text-sm font-semibold text-tinta">{review.author}</p>
                <p class="text-xs text-tinta/50">{dateFormatter.format(new Date(review.date))}</p>
              </div>
            </div>
            <RatingStars rating={review.rating} showValue={false} />
          </div>
          <p class="mt-3 text-sm leading-relaxed text-tinta/80">{review.text[locale]}</p>
        </li>
      ))}
    </ul>
  ) : (
    <p class="mt-4 text-tinta/60">{t(locale, "business.noReviews")}</p>
  )}
</section>
