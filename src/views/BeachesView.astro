---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import BeachGrid from "../components/BeachGrid.astro";
import { type Locale } from "../data/categories";
import { TOWNS, getBeachesByTown } from "../lib/business";
import { t } from "../lib/i18n";
import { townPath, localizedBeachesHrefs } from "../lib/paths";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const hrefs = localizedBeachesHrefs();

const townsWithBeaches = TOWNS.map((town) => ({ town, beaches: getBeachesByTown(town.slug) })).filter(
  (t) => t.beaches.length > 0
);

const siteUrl = Astro.site ?? new URL("https://www.costadelaluzturismo.com");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "site.name"), item: siteUrl.toString() },
    { "@type": "ListItem", position: 2, name: t(locale, "beaches.title"), item: new URL(hrefs[locale], siteUrl).toString() },
  ],
};
---

<BaseLayout locale={locale} title={`${t(locale, "beaches.title")} — ${t(locale, "site.name")}`} description={t(locale, "beaches.metaDescription")} hrefs={hrefs} jsonLd={[jsonLd]}>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="max-w-2xl">
      <h1 class="font-display text-4xl font-semibold text-atlantico sm:text-5xl">{t(locale, "beaches.title")}</h1>
      <p class="mt-3 text-lg leading-relaxed text-tinta/75">{t(locale, "beaches.subtitle")}</p>
    </header>

    {townsWithBeaches.map(({ town, beaches }) => (
      <section class="mt-16">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="font-display text-2xl font-semibold text-atlantico sm:text-3xl">{town.name}</h2>
          <a href={townPath(locale, town.slug)} class="inline-flex flex-none items-center gap-1 text-sm font-medium text-atlantico/70 hover:text-atlantico">
            {t(locale, "guide.exploreTown", { town: town.name.split(" / ")[0] })}
            <Icon name="chevron-right" class="h-4 w-4" />
          </a>
        </div>
        <div class="mt-6">
          <BeachGrid beaches={beaches} locale={locale} />
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
