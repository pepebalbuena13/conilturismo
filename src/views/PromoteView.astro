---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { CATEGORIES, type Locale } from "../data/categories";
import { TOWNS } from "../lib/business";
import { t } from "../lib/i18n";
import { localizedPromoteHrefs } from "../lib/paths";
import { PROMOTE_FORM_EMAIL } from "../lib/promoteConfig";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const hrefs = localizedPromoteHrefs();
const formAction = `https://formsubmit.co/${PROMOTE_FORM_EMAIL}`;
---

<BaseLayout
  locale={locale}
  title={t(locale, "promote.metaTitle")}
  description={t(locale, "promote.metaDescription")}
  hrefs={hrefs}
>
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-terracota">{t(locale, "promote.eyebrow")}</p>
      <h1 class="mt-2 font-display text-4xl font-semibold text-atlantico sm:text-5xl text-balance">{t(locale, "promote.title")}</h1>
      <p class="mt-4 text-lg leading-relaxed text-tinta/75">{t(locale, "promote.subtitle")}</p>
    </header>

    <section class="mt-14">
      <h2 class="font-display text-2xl font-semibold text-atlantico">{t(locale, "promote.plansTitle")}</h2>
      <p class="mt-2 text-tinta/70">{t(locale, "promote.plansSubtitle")}</p>

      <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div class="rounded-3xl bg-white/70 p-6 shadow-card ring-1 ring-tinta/5">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-atlantico/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-atlantico">
            <Icon name="compass" class="h-3.5 w-3.5" />
            {t(locale, "promote.planAnnual")}
          </span>
          <h3 class="mt-3 font-display text-xl font-semibold text-tinta">{t(locale, "promote.planAnnualTitle")}</h3>
          <p class="mt-2 font-display text-2xl font-semibold text-atlantico">{t(locale, "promote.planAnnualPrice")}</p>
          <p class="text-xs text-tinta/60">{t(locale, "promote.planAnnualPriceNote")}</p>
          <p class="mt-2 text-sm text-tinta/70">{t(locale, "promote.planAnnualDescription")}</p>
          <ul class="mt-4 space-y-2 text-sm text-tinta/80">
            <li class="flex gap-2"><Icon name="chevron-right" class="mt-0.5 h-4 w-4 shrink-0 text-terracota" />{t(locale, "promote.planAnnualBullet1")}</li>
            <li class="flex gap-2"><Icon name="chevron-right" class="mt-0.5 h-4 w-4 shrink-0 text-terracota" />{t(locale, "promote.planAnnualBullet2")}</li>
            <li class="flex gap-2"><Icon name="chevron-right" class="mt-0.5 h-4 w-4 shrink-0 text-terracota" />{t(locale, "promote.planAnnualBullet3")}</li>
          </ul>
        </div>

        <div class="rounded-3xl bg-white/70 p-6 shadow-card ring-1 ring-tinta/5">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-dorado/20 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-terracota">
            <Icon name="sun" class="h-3.5 w-3.5" />
            {t(locale, "promote.planSummer")}
          </span>
          <h3 class="mt-3 font-display text-xl font-semibold text-tinta">{t(locale, "promote.planSummerTitle")}</h3>
          <p class="mt-2 font-display text-2xl font-semibold text-atlantico">{t(locale, "promote.planSummerPrice")}</p>
          <p class="text-xs text-tinta/60">{t(locale, "promote.planSummerPriceNote")}</p>
          <p class="mt-2 text-sm text-tinta/70">{t(locale, "promote.planSummerDescription")}</p>
          <ul class="mt-4 space-y-2 text-sm text-tinta/80">
            <li class="flex gap-2"><Icon name="chevron-right" class="mt-0.5 h-4 w-4 shrink-0 text-terracota" />{t(locale, "promote.planSummerBullet1")}</li>
            <li class="flex gap-2"><Icon name="chevron-right" class="mt-0.5 h-4 w-4 shrink-0 text-terracota" />{t(locale, "promote.planSummerBullet2")}</li>
            <li class="flex gap-2"><Icon name="chevron-right" class="mt-0.5 h-4 w-4 shrink-0 text-terracota" />{t(locale, "promote.planSummerBullet3")}</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mt-14 pb-20">
      <h2 class="font-display text-2xl font-semibold text-atlantico">{t(locale, "promote.formTitle")}</h2>
      <p class="mt-2 text-tinta/70">{t(locale, "promote.formSubtitle")}</p>

      <div id="promote-success" class="mt-6 hidden rounded-3xl bg-white/70 p-8 text-center shadow-card ring-1 ring-tinta/5">
        <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-atlantico/10 text-atlantico">
          <Icon name="compass" class="h-6 w-6" />
        </span>
        <h3 class="mt-4 font-display text-xl font-semibold text-tinta">{t(locale, "promote.successTitle")}</h3>
        <p class="mt-2 text-sm text-tinta/70">{t(locale, "promote.successText")}</p>
        <a href={Astro.url.pathname} class="mt-5 inline-block text-sm font-medium text-terracota hover:text-terracota-light">{t(locale, "promote.backToForm")}</a>
      </div>

      <form
        id="promote-form"
        action={formAction}
        method="POST"
        enctype="multipart/form-data"
        class="mt-6 grid grid-cols-1 gap-5 rounded-3xl bg-white/70 p-6 shadow-card ring-1 ring-tinta/5 sm:grid-cols-2 sm:p-8"
      >
        <input type="hidden" name="_subject" value="Nueva solicitud — Promociona tu negocio" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value={`${Astro.url.origin}${Astro.url.pathname}?enviado=1`} />
        <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

        <p class="sm:col-span-2 text-xs text-tinta/50">{t(locale, "promote.requiredHint")}</p>

        <div class="sm:col-span-2">
          <label for="businessName" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-tinta/50">{t(locale, "promote.businessName")} *</label>
          <input id="businessName" name="Nombre del negocio" type="text" required class="tap-target w-full rounded-xl border border-tinta/15 bg-arena-soft px-3 py-2.5 text-sm focus:border-atlantico focus:outline-none" />
        </div>

        <div>
          <label for="category" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-tinta/50">{t(locale, "promote.category")} *</label>
          <select id="category" name="Categoría" required class="tap-target w-full rounded-xl border border-tinta/15 bg-arena-soft px-3 py-2.5 text-sm focus:border-atlantico focus:outline-none">
            <option value="">{t(locale, "promote.categoryPlaceholder")}</option>
            {CATEGORIES.map((cat) => <option value={cat.label[locale]}>{cat.label[locale]}</option>)}
          </select>
        </div>

        <div>
          <label for="town" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-tinta/50">{t(locale, "promote.town")} *</label>
          <select id="town" name="Pueblo" required class="tap-target w-full rounded-xl border border-tinta/15 bg-arena-soft px-3 py-2.5 text-sm focus:border-atlantico focus:outline-none">
            <option value="">{t(locale, "promote.townPlaceholder")}</option>
            {TOWNS.map((town) => <option value={town.name}>{town.name}</option>)}
          </select>
        </div>

        <div class="sm:col-span-2">
          <label for="location" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-tinta/50">{t(locale, "promote.location")}</label>
          <input id="location" name="Ubicación" type="text" placeholder={t(locale, "promote.locationPlaceholder")} class="tap-target w-full rounded-xl border border-tinta/15 bg-arena-soft px-3 py-2.5 text-sm focus:border-atlantico focus:outline-none" />
        </div>

        <div class="sm:col-span-2">
          <label for="description" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-tinta/50">{t(locale, "promote.description")} *</label>
          <textarea id="description" name="Descripción" required rows="4" placeholder={t(locale, "promote.descriptionPlaceholder")} class="w-full rounded-xl border border-tinta/15 bg-arena-soft px-3 py-2.5 text-sm focus:border-atlantico focus:outline-none"></textarea>
        </div>

        <div class="sm:col-span-2">
          <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-tinta/50">{t(locale, "promote.photos")}</p>
          <p class="mb-2 text-xs text-tinta/50">{t(locale, "promote.photosHint")}</p>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label for="photo1" class="mb-1 block text-xs text-tinta/60">{t(locale, "promote.photo1")}</label>
              <input id="photo1" name="Foto 1" type="file" accept="image/*" required class="tap-target w-full rounded-xl border border-tinta/15 bg-arena-soft px-3 py-2 text-xs file:mr-2 file:rounded-full file:border-0 file:bg-atlantico file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-arena-soft" />
            </div>
            <div>
              <label for="photo2" class="mb-1 block text-xs text-tinta/60">{t(locale, "promote.photo2")}</label>
              <input id="photo2" name="Foto 2" type="file" accept="image/*" class="tap-target w-full rounded-xl border border-tinta/15 bg-arena-soft px-3 py-2 text-xs file:mr-2 file:rounded-full file:border-0 file:bg-atlantico file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-arena-soft" />
            </div>
            <div>
              <label for="photo3" class="mb-1 block text-xs text-tinta/60">{t(locale, "promote.photo3")}</label>
              <input id="photo3" name="Foto 3" type="file" accept="image/*" class="tap-target w-full rounded-xl border border-tinta/15 bg-arena-soft px-3 py-2 text-xs file:mr-2 file:rounded-full file:border-0 file:bg-atlantico file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-arena-soft" />
            </div>
          </div>
          <p id="photo-size-error" class="mt-2 hidden text-xs font-medium text-terracota">{t(locale, "promote.sizeError")}</p>
        </div>

        <div class="sm:col-span-2">
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-tinta/50">{t(locale, "promote.planType")} *</p>
          <div class="flex flex-col gap-2 sm:flex-row sm:gap-6">
            <label class="flex items-center gap-2 text-sm text-tinta/80">
              <input type="radio" name="Tipo de promoción" value={t(locale, "promote.planAnnual")} required id="plan-annual" checked class="h-4 w-4 accent-atlantico" />
              {t(locale, "promote.planAnnual")}
            </label>
            <label class="flex items-center gap-2 text-sm text-tinta/80">
              <input type="radio" name="Tipo de promoción" value={t(locale, "promote.planSummer")} required id="plan-summer" class="h-4 w-4 accent-atlantico" />
              {t(locale, "promote.planSummer")}
            </label>
          </div>
        </div>

        <div id="payment-type-wrap" class="sm:col-span-2">
          <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-tinta/50">{t(locale, "promote.paymentType")}</p>
          <div class="flex flex-col gap-2 sm:flex-row sm:gap-6">
            <label class="flex items-center gap-2 text-sm text-tinta/80">
              <input type="radio" name="Forma de pago" id="payment-monthly" checked class="h-4 w-4 accent-atlantico" />
              <span id="payment-monthly-label"></span>
            </label>
            <label class="flex items-center gap-2 text-sm text-tinta/80">
              <input type="radio" name="Forma de pago" id="payment-full" class="h-4 w-4 accent-atlantico" />
              <span id="payment-full-label"></span>
            </label>
          </div>
        </div>

        <div>
          <label for="contactName" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-tinta/50">{t(locale, "promote.contactName")} *</label>
          <input id="contactName" name="Nombre de contacto" type="text" required class="tap-target w-full rounded-xl border border-tinta/15 bg-arena-soft px-3 py-2.5 text-sm focus:border-atlantico focus:outline-none" />
        </div>

        <div>
          <label for="contactEmail" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-tinta/50">{t(locale, "promote.contactEmail")} *</label>
          <input id="contactEmail" name="Email de contacto" type="email" required class="tap-target w-full rounded-xl border border-tinta/15 bg-arena-soft px-3 py-2.5 text-sm focus:border-atlantico focus:outline-none" />
        </div>

        <div class="sm:col-span-2">
          <label for="contactPhone" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-tinta/50">{t(locale, "promote.contactPhone")}</label>
          <input id="contactPhone" name="Teléfono de contacto" type="tel" class="tap-target w-full rounded-xl border border-tinta/15 bg-arena-soft px-3 py-2.5 text-sm focus:border-atlantico focus:outline-none" />
        </div>

        <div class="sm:col-span-2">
          <button type="submit" class="tap-target w-full rounded-full bg-terracota px-6 py-3 text-sm font-semibold text-arena-soft transition-colors hover:bg-terracota-light sm:w-auto">
            {t(locale, "promote.submit")}
          </button>
        </div>
      </form>
    </section>
  </div>
</BaseLayout>

<script
  define:vars={{
    maxTotalBytes: 10 * 1024 * 1024,
    planPrices: {
      annual: { monthly: 50, full: 500, savings: 100 },
      summer: { monthly: 100, full: 350, savings: 50 },
    },
    paymentTemplates: {
      monthly: t(locale, "promote.paymentMonthlyLabel"),
      full: t(locale, "promote.paymentFullLabel"),
    },
  }}
>
  document.addEventListener("astro:page-load", () => {
  const form = document.getElementById("promote-form");
  if (!form) return;
  const successEl = document.getElementById("promote-success");
  const sizeErrorEl = document.getElementById("photo-size-error");
  const planAnnual = document.getElementById("plan-annual");
  const planSummer = document.getElementById("plan-summer");
  const paymentMonthlyInput = document.getElementById("payment-monthly");
  const paymentFullInput = document.getElementById("payment-full");
  const paymentMonthlyLabel = document.getElementById("payment-monthly-label");
  const paymentFullLabel = document.getElementById("payment-full-label");
  const photoInputs = ["photo1", "photo2", "photo3"].map((id) => document.getElementById(id));

  function updatePaymentOptions() {
    const prices = planAnnual.checked ? planPrices.annual : planPrices.summer;
    const monthlyText = paymentTemplates.monthly.replace("{price}", prices.monthly);
    const fullText = paymentTemplates.full.replace("{price}", prices.full).replace("{savings}", prices.savings);
    paymentMonthlyLabel.textContent = monthlyText;
    paymentFullLabel.textContent = fullText;
    paymentMonthlyInput.value = monthlyText;
    paymentFullInput.value = fullText;
  }
  planAnnual?.addEventListener("change", updatePaymentOptions);
  planSummer?.addEventListener("change", updatePaymentOptions);
  updatePaymentOptions();

  function totalPhotoBytes() {
    return photoInputs.reduce((sum, input) => sum + Array.from(input?.files ?? []).reduce((s, f) => s + f.size, 0), 0);
  }

  form?.addEventListener("submit", (e) => {
    if (totalPhotoBytes() > maxTotalBytes) {
      e.preventDefault();
      sizeErrorEl?.classList.remove("hidden");
    } else {
      sizeErrorEl?.classList.add("hidden");
    }
  });

  if (new URLSearchParams(location.search).get("enviado") === "1") {
    form?.classList.add("hidden");
    successEl?.classList.remove("hidden");
    successEl?.scrollIntoView({ behavior: "smooth", block: "start" });
  }
  });
</script>
