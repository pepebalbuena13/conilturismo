---
import BaseLayout from "../layouts/BaseLayout.astro";
import Carousel from "../components/Carousel.astro";
import CategoryChips from "../components/CategoryChips.astro";
import BusinessGrid from "../components/BusinessGrid.astro";
import Icon from "../components/Icon.astro";
import { getCategoryById, type Locale } from "../data/categories";
import { getTown, filterBusinesses } from "../lib/business";
import { t } from "../lib/i18n";
import { homePath, localizedTownHrefs } from "../lib/paths";

interface Props {
  locale: Locale;
  townSlug: string;
  categoryId?: string;
}

const { locale, townSlug, categoryId } = Astro.props;
const town = getTown(townSlug)!;
const category = categoryId ? getCategoryById(categoryId) : undefined;
const businesses = filterBusinesses({ townSlug, category: categoryId, locale });

const title = category
  ? `${category.label[locale]} — ${town.name.split(" / ")[0]}`
  : `${town.name.split(" / ")[0]} — ${t(locale, "site.name")}`;
const description = category
  ? `${category.label[locale]}: ${town.welcome[locale]}`
  : town.welcome[locale];

const hrefs = localizedTownHrefs(townSlug, categoryId);

const gallerySlides = town.gallery.map((caption, i) => ({
  relPath: `${town.slug}/hero/${i + 1}`,
  seed: `${town.gallerySeed}-${i}`,
  label: town.name,
  alt: caption[locale],
  caption: caption[locale],
  showInitials: false,
}));
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  hrefs={hrefs}
  currentTownSlug={townSlug}
>
  <div class="mx-auto max-w-7xl px-4 pt-8 sm:px-6 lg:px-8">
    <a href={homePath(locale)} class="inline-flex items-center gap-1 text-sm font-medium text-atlantico/70 hover:text-atlantico">
      <Icon name="chevron-left" class="h-4 w-4" />
      {t(locale, "town.backToTowns")}
    </a>

    <header class="mt-4 max-w-3xl">
      <h1 class="font-display text-4xl font-semibold text-atlantico sm:text-5xl text-balance">{town.name}</h1>
      <p class="mt-3 text-lg leading-relaxed text-tinta/75">{town.welcome[locale]}</p>
    </header>

    <div class="mt-8">
      <Carousel id={`town-${town.slug}`} locale={locale} slides={gallerySlides} aspectClass="aspect-[16/9] sm:aspect-[21/9]" />
    </div>

    <div class="mt-10">
      <CategoryChips locale={locale} townSlug={townSlug} activeCategory={categoryId} />
    </div>

    <div class="mt-6 flex items-center justify-between">
      <p class="text-sm font-medium text-tinta/60">{t(locale, "town.resultsCount", { count: businesses.length })}</p>
    </div>

    <div class="mt-6 pb-20">
      <BusinessGrid businesses={businesses} locale={locale} />
    </div>
  </div>
</BaseLayout>
