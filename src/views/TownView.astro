---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import Carousel from "../components/Carousel.astro";
import CategoryChips from "../components/CategoryChips.astro";
import BusinessGrid from "../components/BusinessGrid.astro";
import Icon from "../components/Icon.astro";
import { getCategoryById, type Locale } from "../data/categories";
import { getTown, filterBusinesses } from "../lib/business";
import { t } from "../lib/i18n";
import { homePath, townPath, localizedTownHrefs } from "../lib/paths";

interface Props {
  locale: Locale;
  townSlug: string;
  categoryId?: string;
}

const { locale, townSlug, categoryId } = Astro.props;
const town = getTown(townSlug)!;
const category = categoryId ? getCategoryById(categoryId) : undefined;
const businesses = filterBusinesses({ townSlug, category: categoryId, locale });

const title = category
  ? `${category.label[locale]} — ${town.name.split(" / ")[0]}`
  : `${town.name.split(" / ")[0]} — ${t(locale, "site.name")}`;
const description = category
  ? `${category.label[locale]}: ${town.welcome[locale]}`
  : town.welcome[locale];

const hrefs = localizedTownHrefs(townSlug, categoryId);

const gallerySlides = town.gallery.map((caption, i) => ({
  relPath: `${town.slug}/hero/${i + 1}`,
  seed: `${town.gallerySeed}-${i}`,
  label: town.name,
  alt: caption[locale],
  showInitials: false,
}));

const PHOTO_EXTENSIONS = ["jpg", "jpeg", "png", "webp"];
const siteUrl = Astro.site ?? new URL("https://www.costadelaluzturismo.com");
const townOgImage = (() => {
  for (const ext of PHOTO_EXTENSIONS) {
    if (fs.existsSync(path.join(process.cwd(), "public", "images", `${town.slug}/hero/1.${ext}`))) {
      return `/images/${town.slug}/hero/1.${ext}`;
    }
  }
  return "/images/home/cover.webp";
})();

const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: t(locale, "site.name"), item: siteUrl.toString() },
  { "@type": "ListItem", position: 2, name: town.name.split(" / ")[0], item: new URL(townPath(locale, townSlug), siteUrl).toString() },
  ...(category ? [{ "@type": "ListItem", position: 3, name: category.label[locale], item: new URL(hrefs[locale], siteUrl).toString() }] : []),
];

const jsonLd = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: breadcrumbItems },
  ...(!category
    ? [
        {
          "@context": "https://schema.org",
          "@type": "TouristDestination",
          name: town.name,
          description: town.welcome[locale],
          url: new URL(hrefs[locale], siteUrl).toString(),
          geo: { "@type": "GeoCoordinates", latitude: town.lat, longitude: town.lng },
        },
      ]
    : []),
];
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  hrefs={hrefs}
  currentTownSlug={townSlug}
  jsonLd={jsonLd}
  ogImage={townOgImage}
>
  <div class="mx-auto max-w-7xl px-4 pt-8 sm:px-6 lg:px-8">
    <a href={homePath(locale)} class="inline-flex items-center gap-1 text-sm font-medium text-atlantico/70 hover:text-atlantico">
      <Icon name="chevron-left" class="h-4 w-4" />
      {t(locale, "town.backToTowns")}
    </a>

    <div class="mt-4 grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <header>
        <h1 class="font-display text-4xl font-semibold text-atlantico sm:text-5xl text-balance">{town.name}</h1>
        <p class="mt-3 text-lg leading-relaxed text-tinta/75">{town.welcome[locale]}</p>
      </header>

      <Carousel
        id={`town-${town.slug}`}
        locale={locale}
        slides={gallerySlides}
        aspectClass="aspect-[4/3]"
        autoplay
      />
    </div>

    <div class="mt-10">
      <CategoryChips locale={locale} townSlug={townSlug} activeCategory={categoryId} />
    </div>

    <div class="mt-6 flex items-center justify-between">
      <p class="text-sm font-medium text-tinta/60">{t(locale, "town.resultsCount", { count: businesses.length })}</p>
    </div>

    <div class="mt-6 pb-20">
      <BusinessGrid businesses={businesses} locale={locale} />
    </div>
  </div>
</BaseLayout>
