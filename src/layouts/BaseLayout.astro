---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { LOCALES, type Locale } from "../data/categories";
import { t } from "../lib/i18n";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  hrefs: Record<Locale, string>;
  currentTownSlug?: string;
  ogImage?: string;
}

const { locale, title, description, hrefs, currentTownSlug, ogImage } = Astro.props;

const OG_LOCALE: Record<Locale, string> = {
  es: "es_ES",
  en: "en_US",
  de: "de_DE",
  fr: "fr_FR",
};

const siteUrl = Astro.site ?? new URL("https://costadelaluz.guide");
const canonicalUrl = new URL(hrefs[locale], siteUrl);
const fullTitle = `${title} · ${t(locale, "site.name")}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {LOCALES.map((code) => (
      <link rel="alternate" hreflang={code} href={new URL(hrefs[code], siteUrl)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(hrefs.es, siteUrl)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, siteUrl)} />}
    <meta name="twitter:card" content="summary_large_image" />

    <ClientRouter />
  </head>
  <body class="min-h-screen bg-arena font-body text-tinta">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-atlantico focus:px-4 focus:py-2 focus:text-arena-soft">
      Skip to content
    </a>
    <Header locale={locale} hrefs={hrefs} currentTownSlug={currentTownSlug} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
