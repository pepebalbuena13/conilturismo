---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import type { Locale } from "../data/categories";
import { t } from "../lib/i18n";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  altHref: string;
  canonicalPath: string;
  currentTownSlug?: string;
  ogImage?: string;
}

const {
  locale,
  title,
  description,
  altHref,
  canonicalPath,
  currentTownSlug,
  ogImage,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://costadelaluz.guide");
const canonicalUrl = new URL(canonicalPath, siteUrl);
const esUrl = new URL(locale === "es" ? canonicalPath : altHref, siteUrl);
const enUrl = new URL(locale === "en" ? canonicalPath : altHref, siteUrl);
const fullTitle = `${title} · ${t(locale, "site.name")}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, siteUrl)} />}
    <meta name="twitter:card" content="summary_large_image" />

    <ClientRouter />
  </head>
  <body class="min-h-screen bg-arena font-body text-tinta">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-atlantico focus:px-4 focus:py-2 focus:text-arena-soft">
      Skip to content
    </a>
    <Header locale={locale} altHref={altHref} currentTownSlug={currentTownSlug} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
